---
import { IconArrowUp } from '@tabler/icons-astro';
import Button from '../components/Button.astro';
---

<footer class="bg-pallete-5 text-pallete-1 pt-5 pb-25 lg:pb-5">
    <div class="flex justify-center mb-5">
        <Button 
            variant='secondary'
            iconOnly
            ariaLabel='Back to top'
            class="back-to-top"
        >
            <IconArrowUp class="w-5 h-5 stroke-[2.5]" />
        </Button>

        <script>
            function initBackToTop() {
                const backToTopBtn = document.querySelector('.back-to-top');

                if (!backToTopBtn) return;

                function scrollToTop() {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                }

                backToTopBtn.addEventListener('click', scrollToTop);
            }

            document.addEventListener('DOMContentLoaded', initBackToTop);
            document.addEventListener('astro:page-load', initBackToTop);
        </script>
    </div>
    <div class="group">
        <div class="border-y border-pallete-1 text-pallete-1 transition-all duration-300 ease-in-out group-hover:bg-pallete-1">
            <div class="container px-5 md:px-10 lg:px-20 relative py-5">
                <div class="flex flex-row justify-between items-end group-hover:text-pallete-6">
                    <div class="text-3xl font-bold tracking-tight">titoriskimianto.</div>
                    <div class="text-sm">
                        <p>&copy;2026<br/>Crafted with care.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>