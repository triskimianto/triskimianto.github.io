---
import TrLogo from "../assets/tr-logo-26.svg";
---

<main class="bg-pallete-5 text-pallete-1 font-fira">
	<div class="h-screen p-8 md:p-16 flex flex-col lg:flex-row gap-12 justify-between items-stretch">
		<div class="flex flex-col justify-between lg:w-1/2 pb-8 lg:pb-0 lg:pr-12 border-b lg:border-b-0 lg:border-r border-pallete-1/30">
			<header class="flex items-center gap-2">
				<TrLogo class="w-8 h-8" />
				<span class="font-bold text-xl tracking-tight">titoriskimianto.</span>
			</header>
			<h1 class="text-[12vw] lg:text-[8vw] font-black tracking-tight uppercase leading-[0.85] text-left my-12 lg:my-0">
				Coming
				<br>
				<span class="text-pallete-2">Soon.</span>
			</h1>
			<div class="hidden lg:block text-xs uppercase tracking-widest text-pallete-1/60">Portfolio V2 • 2026</div>
		</div>
		<div class="flex flex-col justify-between pt-4 lg:pt-0 lg:w-1/2 lg:pl-12">
			<div class="max-w-md space-y-6">
				<h2 class="text-xl lg:text-2xl font-bold leading-snug">
					Crafting a refined personal space designed for speed, aesthetics, and clean interactions.
				</h2>
				<p class="text-sm text-pallete-1/80 leading-relaxed font-medium">
					Currently under heavy development using a modern stack. Refining components, layout structures, and responsiveness to bring you the best version of my digital corner.
				</p>
			</div>
			<footer>
				<ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm font-semibold uppercase tracking-wider mt-16">
					<li>
						<a href="https://github.com/triskimianto" class="transition-colors duration-300 hover:text-pallete-4" target="_blank">GitHub</a>
					</li>
					<li>
						<a href="https://id.linkedin.com/in/tito-riskimianto-3b621a220" class="transition-colors duration-300 hover:text-pallete-4" target="_blank">LinkedIn</a>
					</li>
				</ul>
			</footer>
		</div>
	</div>
</main>