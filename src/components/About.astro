---
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import ui from '../data/ui/en.json';
import content from '../data/content/en.json';
---

<section id="about" class="lg:scroll-mt-24">
    <div class="bg-pallete-5 text-pallete-1/75">
        <div class="container mx-auto px-5 py-10 md:px-10 md:py-20 lg:px-20 lg:py-30">
            <h2 class="text-5xl lg:text-7xl text-pallete-1 font-extrabold text-center mb-5 uppercase">
                {ui.about.heading}
            </h2>
            <p class="text-center mb-10">
                {ui.about.description}
            </p>

            <h2 class="text-5xl lg:text-7xl text-pallete-1 font-extrabold mb-5 uppercase">
                {ui.tech_stack.heading}
            </h2>

            <h3 class="mb-3 text-lg font-semibold">
                {ui.tech_stack.work.heading}
            </h3>
            <ul class="flex flex-wrap items-center gap-2 mb-5">
                {content.tech_stack.work.map((tech) => (
                    <li>
                        <Badge>{tech}</Badge>
                    </li>
                ))}
            </ul>

            <h3 class="mb-3 text-lg font-semibold">
                {ui.tech_stack.personal.heading}
            </h3>
            <ul class="flex flex-wrap items-center gap-2 mb-10">
                {content.tech_stack.personal.map((tech) => (
                    <li>
                        <Badge color="clr2">{tech}</Badge>
                    </li>
                ))}
            </ul>

            <h2 class="text-5xl lg:text-7xl text-pallete-1 font-extrabold mb-5 uppercase text-center">
                {ui.career_edu.heading}
            </h2>
            <p class="text-center mb-10">
                {ui.career_edu.description}
            </p>
            <div class="md:max-w-150 mx-auto">
                <ul class="flex flex-col gap-5">
                    {content.career.map((career) => (
                        <li>
                            <Card>
                                <div class="flex flex-col gap-1">
                                    <h3 class="text-xl lg:text-2xl text-pallete-1 font-extrabold uppercase">{career.company}</h3>
                                    <div class="flex flex-wrap items-center gap-2">
                                        {career.position ? (
                                            <span>{career.position}</span>
                                        ) : null}
                                        {career.type ? ( 
                                            <span>&bull;</span>                                                           
                                            <span>{career.type}</span>
                                        ) : null}
                                    </div>
                                    <div>
                                        <span>                                            
                                            {career.period ? (
                                                <span>{career.period.start} - {career.period.end}</span>
                                            ) : null}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-3">
                                    {career.description ? (
                                        <p class="text-pallete-1 mt-5">{career.description}</p>
                                    ) : null}
                                    <div class="flex flex-wrap items-center gap-1">
                                        {career.tech ? (
                                            career.tech.map((t) => (
                                                <Badge>{t}</Badge>
                                            ))
                                        ) : null}
                                    </div>
                                </div>
                            </Card>
                        </li>
                    ))}
                    {content.education.map((education) => (
                        <li>
                            <Card>
                                <div class="flex flex-col gap-1">
                                    <h3 class="text-xl lg:text-2xl text-pallete-1 font-extrabold uppercase">{education.institution}</h3>
                                    <div class="flex flex-wrap items-center gap-2">
                                        {education.degree ? (
                                            <span>{education.degree}</span>
                                        ) : null}
                                        {education.program ? ( 
                                            <span>{education.program}</span>
                                        ) : null}
                                        {education.field ? (                                                            
                                            <span>&bull;</span>
                                            <span>{education.field}</span>
                                        ) : null}                                        
                                        {education.type !== "University" ? (                                                            
                                            <span>&bull;</span>
                                            <span>Training</span>
                                        ) : null}
                                    </div>
                                    <div>
                                        <span>                                            
                                            {education.period ? (
                                                <span>{education.period.start} - {education.period.end}</span>
                                            ) : null}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-3">
                                    {education.description ? (
                                        <p class="text-pallete-1 mt-5">{education.description}</p>
                                    ) : null}                                    
                                </div>
                            </Card>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>