---
import TrLogo from '../assets/tr-logo-26.svg';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import content from '../data/locales/en.json';
---

<section id="hero" class="lg:scroll-mt-24">
    <div class="bg-pallete-5 text-pallete-1/75">
        <div class="container h-[calc(100vh-72px)] mx-auto px-5 py-10 md:px-10 md:py-20 lg:px-20 lg:pb-30">
            <div class="flex flex-col gap-5 h-full md:flex-row-reverse lg:gap-10">
                <div class="w-full md:h-full md:w-1/3">
                    <Card color='hero1'>
                        <div class="flex justify-center items-center md:h-full">
                            <TrLogo class="text-pallete-5 w-26 h-26 lg:w-48 lg:h-48 xl:w-56 xl:h-56" />
                        </div>
                    </Card>
                </div>
                <div class="w-full md:h-full md:w-2/3">
                    <Card color='hero2'>
                        <div class="flex flex-col justify-between items-start gap-5 md:h-full">
                            <h2 class="text-sm">{content.hero.subheading}</h2>
                            <div>
                                <h1 class="text-4xl font-extrabold tracking-wide mb-1 text-pallete-1 uppercase whitespace-pre-line lg:text-5xl">
                                    {content.hero.heading.before}                                
                                    <span class="text-pallete-2">{content.hero.heading.highlight}</span>
                                </h1>
                                <p class="text-sm lg:text-lg">{content.hero.description}</p>
                            </div>
                            <div class="flex flex-col justify-center items-center gap-2 w-full md:flex-row md:gap-4">
                                <Button href={content.hero.cta.primary.link} variant='primary' class='w-full'>
                                    {content.hero.cta.primary.label}
                                </Button>
                                <Button href={content.hero.cta.secondary.link} variant='secondary' class='w-full'>
                                    {content.hero.cta.secondary.label}
                                </Button>
                            </div>
                        </div>
                    </Card>
                </div>
            </div>
        </div>
    </div>
</section>