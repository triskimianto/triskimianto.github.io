---
import HeaderLogo from '../components/HeaderLogo.astro';
import NavMenu from '../components/NavMenu.astro';
---

<header id="main-header" class="relative z-40 transition-all duration-300 bg-pallete-5 text-pallete-1">
    <div class="container px-5 md:px-10 lg:px-20 mx-auto relative">
        <div id="header-container" class="flex items-center justify-center py-5 lg:justify-between transition-all duration-300">
            <a href="/">
                <HeaderLogo/>
            </a>
            <div class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full z-50 bg-linear-to-t from-black/25 to-transparent lg:static lg:translate-x-0 lg:bg-none lg:w-auto">
                <div class="w-full max-w-xs mx-auto mb-5 md:max-w-sm lg:w-auto lg:max-w-none lg:mb-0">
                    <div class="bg-pallete-5/25 backdrop-blur-sm border border-pallete-6/50 p-1 mt-2 rounded-full lg:bg-transparent lg:backdrop-blur-none lg:border-none lg:px-0 lg:py-0 lg:mt-0">
                        <NavMenu/>
                    </div>  
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    const mainHeader = document.getElementById('main-header');
    const headerContainer = document.getElementById('header-container');

    function handleScroll() {    
        if (window.innerWidth >= 1024) {
            if (window.scrollY > 50) {
                mainHeader?.classList.add(
                    'lg:fixed',
                    'lg:top-0',
                    'lg:left-0',
                    'lg:w-full',
                    'lg:bg-transparent',
                    'lg:bg-linear-to-b',
                    'lg:from-black/25', 
                    'lg:to-transparent'
                );
                headerContainer?.classList.add(
                    'lg:backdrop-blur-sm',
                    'lg:bg-pallete-5/25',
                    'lg:border',
                    'lg:border-pallete-6/50',
                    'rounded-full',
                    'lg:px-10',
                    'lg:py-3',
                    'lg:mt-5',
                    'lg:mb-2',
                    'lg:-mx-10'
                );
            } else {
                mainHeader?.classList.remove(
                    'lg:fixed',
                    'lg:top-0',
                    'lg:left-0',
                    'lg:w-full',
                    'lg:bg-transparent',
                    'lg:bg-linear-to-b',
                    'lg:from-black/25', 
                    'lg:to-transparent',
                );
                headerContainer?.classList.remove(
                    'lg:backdrop-blur-sm',
                    'lg:bg-pallete-5/25',
                    'lg:border',
                    'lg:border-pallete-6/50',
                    'rounded-full',
                    'lg:px-10',
                    'lg:py-3',
                    'lg:mt-5',
                    'lg:mb-2',
                    'lg:-mx-10'
                );
            }
        }
    }

    window.addEventListener('scroll', handleScroll);
    window.addEventListener('resize', handleScroll);
</script>